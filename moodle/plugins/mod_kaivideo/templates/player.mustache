{{!
    The player.

    The controls are ours, not the backend's. With YouTube's own controls a
    learner can seek and resume from inside the iframe, where nothing in this
    module can intervene, and "the video will not continue past an unanswered
    question" would stop being true. A file could keep its native controls, but
    two different-looking players in one activity type is its own problem.
}}
<div class="kaivideo" data-region="kaivideo" data-state="loading"
     data-provider="{{provider}}">

    {{#noquestions}}
    <div class="alert alert-info" data-region="noquestions">
        {{#str}}noquestions, mod_kaivideo{{/str}}
        {{#canedit}}<a href="{{editurl}}">{{#str}}editquestions, mod_kaivideo{{/str}}</a>{{/canedit}}
    </div>
    {{/noquestions}}

    {{!
        Sized rather than left to fill whatever it likes. A <video> with no
        poster renders as its intrinsic box on a black background, which came
        out as a screen-high black rectangle with a small white square in the
        middle of it before anybody pressed play.
    }}
    <div class="kaivideo-stage position-relative bg-dark mx-auto"
         style="max-width: 56rem;" data-region="stage">
        {{! Both backends get the same 16:9 frame. Without it the file player
            has no shape until metadata arrives, and what a learner sees on
            arrival is a tall black rectangle with a small white box floating
            in it. }}
        {{#isfile}}
        <div class="ratio ratio-16x9">
            <video data-region="video" preload="metadata" src="{{videourl}}"
                   style="object-fit: contain;"></video>
        </div>
        {{/isfile}}
        {{^isfile}}
        {{! Replaced by the iframe once YouTube's API has loaded. }}
        <div class="ratio ratio-16x9">
            <div data-region="youtube"></div>
        </div>
        {{/isfile}}

        {{!
            Drawn over the video rather than beside it. A question in the margin
            is a question a learner scrolls past; one that covers the frame is
            the interruption it is meant to be.
        }}
        {{!
            The element carrying `hidden` must not also carry a class that sets
            display. `d-flex` was on this div, and Bootstrap's rule beat the
            [hidden] attribute — so the panel was on screen from the moment the
            page loaded, as an empty white card floating in the middle of the
            video. The centring moved inside; nothing styles display out here.

            The tests did not catch it because they matched :not([hidden]),
            which was true of the attribute while the panel was plainly visible.
        }}
        <div class="kaivideo-question position-absolute top-0 start-0 w-100 h-100"
             style="background: rgba(0, 0, 0, 0.75);"
             data-region="question" hidden>
            <div class="d-flex align-items-center justify-content-center
                        w-100 h-100 p-3">
            <div class="card shadow" style="max-width: 34rem; width: 100%;">
                <div class="card-body">
                    <p class="lead mb-3" data-region="questiontext"></p>
                    <div data-region="choices" class="d-grid gap-2"></div>

                    <div data-region="outcome" hidden>
                        <p data-region="verdict" class="mb-1"></p>
                        <p data-region="feedback" class="text-muted"></p>
                        <button type="button" class="btn btn-primary"
                                data-action="continue">
                            {{#str}}continue, mod_kaivideo{{/str}}
                        </button>
                        <button type="button" class="btn btn-outline-secondary"
                                data-action="retry" hidden>
                            {{#str}}tryagain, mod_kaivideo{{/str}}
                        </button>
                    </div>
                </div>
            </div>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 mt-2 mx-auto"
         style="max-width: 56rem;" data-region="controls">
        <button type="button" class="btn btn-primary" data-action="play">
            {{#str}}play, mod_kaivideo{{/str}}
        </button>
        <button type="button" class="btn btn-outline-secondary" data-action="pause">
            {{#str}}pause, mod_kaivideo{{/str}}
        </button>
        {{! Back only. A control that jumps forward is a control for skipping
            questions, so there is not one. }}
        <button type="button" class="btn btn-outline-secondary" data-action="back">
            {{#str}}back10, mod_kaivideo{{/str}}
        </button>
        {{! Short. The sentence that used to sit here explained the rule in
            full, next to the buttons, on every frame of every viewing. }}
        <span class="small text-muted ms-auto" data-region="summary">
            {{#str}}questioncount, mod_kaivideo, {{questioncount}}{{/str}}
        </span>
    </div>

    <div class="alert alert-warning mt-2" data-region="problem" hidden></div>
</div>
