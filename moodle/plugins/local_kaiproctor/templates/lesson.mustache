{{!
    Monitored lesson page.

    Context variables:
    * videourl  - the lesson video to play
    * enrolled  - whether identity re-checks can run
}}
<div class="kaiproctor-lesson" data-region="kaiproctor-lesson">
    {{^enrolled}}
        <div class="alert alert-warning">
            {{#str}}lesson:notenrolled, local_kaiproctor{{/str}}
        </div>
    {{/enrolled}}

    <div class="kaiproctor-lesson-stage">
        {{! controls are omitted: the monitor decides when playback resumes }}
        <video data-region="lesson-video" class="kaiproctor-lesson-video"
               src="{{videourl}}" playsinline></video>
        <video data-region="preview" class="kaiproctor-preview kaiproctor-preview-corner"
               playsinline muted></video>
    </div>

    <div class="alert" data-region="status" role="status" aria-live="polite" hidden></div>

    <button type="button" class="btn btn-primary" data-action="start">
        {{#str}}lesson:start, local_kaiproctor{{/str}}
    </button>
</div>
