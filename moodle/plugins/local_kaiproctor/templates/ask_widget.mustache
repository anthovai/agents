{{!
    The assistant, as a button on every page.

    Deliberately small and closed by default. It sits above Moodle's own help
    button rather than on top of it, and it is the only thing this plugin puts
    on pages it does not own — a plugin that decorates every page in a site
    has to earn each pixel.
}}
<div class="kaiproctor-assistant" data-region="assistant-widget" data-open="0">

    {{!
        A speech bubble rather than a question mark. The "?" it used to carry
        sat directly above Moodle's own round "?" help button, so the page
        ended up with two identical circles meaning different things — and
        neither said "you can type to this".

        Drawn inline rather than pulled from an icon font: this button is
        rendered on every page of the site, and a glyph that depends on the
        theme's font is one that goes missing on somebody else's theme.
    }}
    <button type="button" class="btn btn-primary rounded-circle shadow d-flex
                   align-items-center justify-content-center"
            data-action="assistant-toggle"
            style="position: fixed; right: 1.25rem; bottom: 5rem; z-index: 1040;
                   width: 3.25rem; height: 3.25rem; padding: 0;"
            aria-expanded="false"
            aria-controls="kaiproctor-assistant-panel"
            title="{{#str}}ask:title, local_kaiproctor{{/str}}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38
                     8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5
                     8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0
                     1 8 8v.5z"/>
            <circle cx="8.5" cy="11.5" r="1" fill="currentColor" stroke="none"/>
            <circle cx="12" cy="11.5" r="1" fill="currentColor" stroke="none"/>
            <circle cx="15.5" cy="11.5" r="1" fill="currentColor" stroke="none"/>
        </svg>
        <span class="sr-only">{{#str}}ask:title, local_kaiproctor{{/str}}</span>
    </button>

    <div id="kaiproctor-assistant-panel" class="card shadow"
         data-region="assistant-panel"
         style="position: fixed; right: 1.25rem; bottom: 9.5rem; z-index: 1040;
                width: min(22rem, calc(100vw - 2.5rem)); max-height: 70vh;
                display: flex; flex-direction: column;"
         hidden>

        <div class="card-header d-flex align-items-center justify-content-between py-2">
            <strong class="small">{{#str}}ask:title, local_kaiproctor{{/str}}</strong>
            <button type="button" class="btn btn-sm btn-link p-0"
                    data-action="assistant-close"
                    aria-label="{{#str}}closebuttontitle{{/str}}">&times;</button>
        </div>

        <div class="card-body py-2" data-region="conversation"
             style="overflow-y: auto;">
            <p class="small text-muted mb-0" data-region="intro">
                {{#str}}ask:intro, local_kaiproctor{{/str}}
            </p>
        </div>

        <div class="card-footer py-2">
            <form data-action="assistant-form" class="d-flex gap-1">
                <label class="sr-only" for="kaiproctor-assistant-input">
                    {{#str}}ask:title, local_kaiproctor{{/str}}
                </label>
                <input type="text" class="form-control form-control-sm"
                       id="kaiproctor-assistant-input" data-region="question"
                       autocomplete="off"
                       placeholder="{{#str}}ask:placeholder, local_kaiproctor{{/str}}">
                <button type="submit" class="btn btn-sm btn-primary"
                        data-action="assistant-send">
                    {{#str}}ask:send, local_kaiproctor{{/str}}
                </button>
            </form>
            <a href="{{fullpageurl}}" class="small">{{#str}}ask:openfull, local_kaiproctor{{/str}}</a>
        </div>
    </div>
</div>
