.env
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Model weights are large and fetched by face-service/models/fetch.sh.
# LICENSES.md and fetch.sh are tracked; the binaries are not.
face-service/models/*.onnx

# Real faces used for threshold calibration must never reach the repository.
face-service/tests/faces/

# Public-domain portraits for the sanity check, fetched by
# face-service/fetch-reference-faces.py. The script and CREDITS are tracked;
# the images are not.
face-service/tests/faces-public/

# Test artefacts are regenerated by run-tests.sh. REPORT.md is kept because it
# is the deliverable; the recordings and screenshots behind it are not small.
reports/video/
reports/screenshots/
reports/.rawvideo/
reports/pytest-output.txt
reports/junit.xml
# The calibration report names real people and their scores.
reports/CALIBRATION.md
reports/SANITY-CHECK.md

# Third-party Moodle plugins, fetched by moodle/plugins/fetch-third-party.sh.
moodle/plugins/mod_interactivevideo/

# Test fixtures built by face-service/tests/make_sample_pdf.py, including the
# OFL font it downloads. The generator is tracked; its output is not.
face-service/tests/sample-exam.pdf
face-service/tests/*.ttf
ai-service/reports/

# Backups of the env file carry the same secrets the env file does.
.env.bak

# Holds the OpenAI key and both service keys.
deploy/digitalocean/.env

# Real keys for the running deployment. Never committed.
handoff/
