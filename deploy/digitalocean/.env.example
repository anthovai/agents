# Copy to .env beside this file, fill in, and keep it off the repository.
#   cp deploy/digitalocean/.env.example deploy/digitalocean/.env

# --- where it answers ------------------------------------------------------
# Must already resolve to this droplet before the first start: Caddy asks
# Let's Encrypt for a certificate immediately, and the challenge is answered
# over port 80 on this name.
SITE_DOMAIN=api.example.com

# --- keys the callers send -------------------------------------------------
# Two separate keys on purpose. One customer having the face key must not also
# mean they can read every conversation on the agent.
#
# Generate each with:  openssl rand -hex 32
FACE_API_KEY=

# The agent takes one key per caller, written label:key and comma separated:
#     RAG_API_KEY=acme:9f3c...,internal:2b71...
# A leaked key is then revoked on its own, the rate limit is counted per
# caller, and a log line says which one. A bare key with no label also works.
RAG_API_KEY=

# Model-backed calls per caller per minute, and the burst allowed after a
# quiet spell. 0 switches the limit off, which leaves nothing between a retry
# loop and the OpenAI bill.
RAG_RATE_PER_MINUTE=20
RAG_RATE_BURST=10

# --- what the agent thinks with --------------------------------------------
# Billed per call. Every question and every retrieved chunk goes to this
# endpoint — see the note in docker-compose.yml before deciding it is the
# right one for this client.
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_MODEL=gpt-5-mini

# --- face thresholds -------------------------------------------------------
# Defaults are OpenCV's reference values, NOT calibrated ones. Run
# calibrate.py against real enrolment photos and put the measured numbers
# here before anybody's identity is decided by them.
FACE_MATCH_THRESHOLD=0.363
FACE_REVIEW_MIN=0.30
FACE_LIVENESS_THRESHOLD=0.60
FACE_DET_SCORE=0.80
