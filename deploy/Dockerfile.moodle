# The Moodle image for a server, with our plugins built in.
#
# The development image mounts the plugins from the working copy so editing a
# PHP file needs no rebuild. On a server that is exactly wrong: what is running
# should be a thing that was built once and can be rolled back to, not a
# directory somebody might have edited at three in the morning.
#
# So this copies them in, and the image tag is what identifies a deployment.

FROM php:8.3-apache

ARG MOODLE_TARBALL=https://packaging.moodle.org/stable501/moodle-latest-501.tgz

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq-dev libpng-dev libjpeg-dev libfreetype6-dev libzip-dev \
        libxml2-dev libicu-dev libcurl4-openssl-dev \
        cron ghostscript unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        pgsql pdo_pgsql gd zip intl soap exif opcache \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN a2enmod rewrite headers

# Moodle 5.0 moved the web root into public/. Everything above it — config.php,
# admin/cli, vendored code — must stay off the web.
RUN sed -ri 's!/var/www/html!/var/www/html/public!g' \
        /etc/apache2/sites-available/000-default.conf \
        /etc/apache2/apache2.conf

# Apache's default is 300, below the 330 the plugin waits for the AI service.
# Left alone it cuts the connection first and the learner gets a bare 504
# instead of the service's own account of what went wrong. The chain has to
# widen outwards: ai-service 300 < ai_client 330 < Apache 420 < the browser.
RUN sed -ri 's/^Timeout [0-9]+/Timeout 420/' /etc/apache2/apache2.conf

# Production PHP settings. The stock php.ini-production plus what Moodle needs
# and what a proctored session needs: evidence clips are uploaded from the
# browser, and the defaults are smaller than a short WebM.
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && { \
        echo 'upload_max_filesize = 32M'; \
        echo 'post_max_size = 32M'; \
        echo 'max_execution_time = 300'; \
        echo 'memory_limit = 512M'; \
        echo 'opcache.enable = 1'; \
        echo 'opcache.validate_timestamps = 0'; \
        echo 'expose_php = Off'; \
    } > "$PHP_INI_DIR/conf.d/zz-kaiproctor.ini"

RUN curl -fsSL "$MOODLE_TARBALL" -o /tmp/moodle.tgz \
    && tar -xzf /tmp/moodle.tgz -C /tmp \
    && cp -r /tmp/moodle/. /var/www/html/ \
    && rm -rf /tmp/moodle /tmp/moodle.tgz

# Ours, baked in. A deployment is then the image tag and nothing else.
COPY moodle/plugins/local_kaiproctor /var/www/html/public/local/kaiproctor
COPY moodle/plugins/quizaccess_kaiproctor /var/www/html/public/mod/quiz/accessrule/kaiproctor
COPY moodle/plugins/mod_kaivideo /var/www/html/public/mod/kaivideo

# Third-party, and optional: fetched by moodle/plugins/fetch-third-party.sh
# before building. Absent is fine — nothing depends on it.
COPY docker/moodle-entrypoint.sh /usr/local/bin/moodle-entrypoint
RUN chmod +x /usr/local/bin/moodle-entrypoint

RUN chown -R www-data:www-data /var/www/html

ENTRYPOINT ["moodle-entrypoint"]
CMD ["apache2-foreground"]
