# Copy to deploy/.env and fill in. Nothing here has a safe default, which is
# why the compose file refuses to start rather than inventing one.
#
#   cp deploy/.env.example deploy/.env

# The address learners will type. https, and no trailing slash — Moodle builds
# every link from this, and a wrong value produces a site that half-works.
MOODLE_WWWROOT=https://proctor.example.co.th

# --- database ---------------------------------------------------------------
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
# openssl rand -base64 32
MOODLE_DB_PASS=

# --- the first administrator ------------------------------------------------
# Change the password after the first sign-in; this value sits in a file on the
# server for as long as it stays here.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=
MOODLE_ADMIN_EMAIL=

# --- the secret Moodle shares with the two side-car services ----------------
# openssl rand -hex 32
PROCTOR_API_KEY=

# --- face matching ----------------------------------------------------------
# NOT CALIBRATED. 0.363 is the SFace authors' reference value, not a number
# measured against your learners' cameras. Read the warning in docs/DEPLOY.md
# before you rely on it to decide anything.
FACE_MATCH_THRESHOLD=0.363
FACE_REVIEW_MIN=0.30
FACE_LIVENESS_THRESHOLD=0.60
# Detector confidence. Was 0.9 and rejected real faces; see
# reports/DETECTION-CALIBRATION.txt.
FACE_DET_SCORE=0.80

# How much of the machine the face service may take. Enrolment is the
# constraint, and it is CPU-bound: reports/FACE-LOAD.txt.
FACE_CPUS=4
FACE_MEMORY=2g

# --- AI assistance (optional, and off in Moodle until switched on) ----------
# Points at a model on this host by default. A model you run yourself is the
# only configuration where learner activity never leaves the building.
AI_LLM_BASE_URL=http://host.docker.internal:11434/v1
AI_LLM_MODEL=qwen2.5:7b-instruct
AI_MODEL_ASK=qwen3:8b
AI_LLM_API_KEY=
AI_TIMEOUT=300

# --- where Moodle listens on the host, for the reverse proxy ---------------
MOODLE_HTTP_PORT=8080
