# Copy to .env before the first `docker compose up`.

MOODLE_WWWROOT=http://localhost:8080

MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASS=change-me-db

MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=change-me-Admin1!
MOODLE_ADMIN_EMAIL=admin@example.com

# Shared secret between Moodle and face-service. Set the same value in
# Site administration > Plugins > Local plugins > KAISER Proctor.
PROCTOR_API_KEY=change-me-secret

# SFace reference values. NOT calibrated — see docs/MIGRATION.md before
# treating a decision made with these as evidence of anything.
FACE_MATCH_THRESHOLD=0.363
FACE_REVIEW_MIN=0.30
FACE_LIVENESS_THRESHOLD=0.60

# AI review (optional). Start it with:  docker compose --profile ai up -d
# Without a key the gateway still runs and the plugin reports the feature
# unavailable, which is the right behaviour for something advisory.
OPENAI_API_KEY=
LITELLM_MASTER_KEY=sk-kaiproctor-local

# --- AI reviewer service -----------------------------------------------
# Defaults to Ollama on the Docker host: a model on hardware you control is
# the only configuration where learner activity never leaves the building.
# Any OpenAI-compatible endpoint works here, including a LiteLLM gateway.
AI_LLM_BASE_URL=http://host.docker.internal:11434/v1
AI_LLM_MODEL=qwen2.5:7b-instruct
AI_LLM_API_KEY=
