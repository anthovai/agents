# Copy to .env before `docker compose up -d`. The real .env is gitignored.

# --- who may call this service -------------------------------------------
# Sent by callers as X-Agent-Key. Empty disables the check entirely, which is
# right on one laptop and wrong the moment a second machine can reach the port.
#
# One key per caller, written label:key and comma separated:
#     RAG_API_KEY=acme:9f3c...,internal:2b71...
# so that one can be revoked without the others, and so the rate limit and the
# logs can name which caller. A bare key with no label also works.
RAG_API_KEY=

# --- how often ------------------------------------------------------------
# Model-backed calls per caller per minute, and the burst allowed after a
# quiet spell. Nothing else stands between a retry loop and the bill.
RAG_RATE_PER_MINUTE=20
RAG_RATE_BURST=10

# --- which model answers ---------------------------------------------------
# The hosted default. Every question and every retrieved chunk goes to OpenAI
# under this setting — read the note in docker-compose.yml before shipping it.
RAG_LLM_BASE_URL=https://api.openai.com/v1
RAG_LLM_MODEL=gpt-5-mini
RAG_LLM_API_KEY=

# Nothing leaves the building under this one instead:
# RAG_LLM_BASE_URL=http://host.docker.internal:11434/v1
# RAG_LLM_MODEL=qwen2.5:7b-instruct
# RAG_LLM_API_KEY=

# --- the learner catalogue -------------------------------------------------
# A second index, in the same mounted directory, built from the LMS knowledge
# export by `docker compose run --rm build-learner-index`. It answers the
# /learner/* endpoints and nothing else: learners must never be shown the
# controller, API and table names the first index is made of, which is why
# this is a separate file rather than more rows in that one.
#
# Comment it out and /learner/* reports that it is not configured; the
# developer endpoints are unaffected either way.
RAG_LEARNER_INDEX_PATH=/index/learner-index.sqlite

# Where the export JSON lives on this machine, for the builder above.
# RAG_LEARNER_EXPORT=./lms-agent-knowledge-company-1.json
